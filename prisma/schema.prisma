// Схема Prisma — добавляйте модели по мере разработки

generator client {
  provider = "prisma-client"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

enum MeasurementUnitKind {
  mass
  volume
  count
  informal
  serving
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  recipes Recipe[]
  cart    Cart?
}

model Recipe {
  id              String   @id @default(cuid())
  title           String
  description     String
  image           String
  authorId        String   @map("author_id")
  outputQuantity  Decimal  @map("output_quantity") @db.Decimal(10, 2)
  outputUnitId    String   @map("output_unit_id")
  servings        Int?     @map("servings")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  author              User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  outputUnit          MeasurementUnit    @relation(fields: [outputUnitId], references: [id], onDelete: Restrict)
  nutrition           RecipeNutrition?
  ingredientGroups    RecipeIngredientGroup[]
  equipment           RecipeEquipment[]
  steps               RecipeStep[]
  comments            RecipeComment[]
  preparedIngredient  Ingredient?        @relation("IngredientPreparedRecipe")

  @@index([authorId])
  @@index([outputUnitId])
}

model RecipeNutrition {
  id        String   @id @default(cuid())
  recipeId  String   @unique @map("recipe_id")
  calories  Int
  protein   Decimal  @db.Decimal(6, 2)
  fat       Decimal  @db.Decimal(6, 2)
  carbs     Decimal  @db.Decimal(6, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Ingredient {
  id        String   @id @default(cuid())
  name      String   @unique
  sticker   String
  recipeId  String?  @unique @map("recipe_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipe Recipe?            @relation("IngredientPreparedRecipe", fields: [recipeId], references: [id], onDelete: SetNull)
  usages RecipeIngredient[]

  @@index([recipeId])
}

model MeasurementUnit {
  id                String              @id @default(cuid())
  name              String
  shortName         String              @unique @map("short_name")
  kind              MeasurementUnitKind
  roundToInteger    Boolean             @default(false) @map("round_to_integer")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  ingredients            RecipeIngredient[]
  recipeOutputs          Recipe[]
  ingredientGroupOutputs RecipeIngredientGroup[]
  cartItems              CartItem[]
}

model RecipeIngredient {
  id           String   @id @default(cuid())
  groupId      String   @map("group_id")
  ingredientId String   @map("ingredient_id")
  unitId       String   @map("unit_id")
  order        Int
  quantity     Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  group      RecipeIngredientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ingredient Ingredient             @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unit       MeasurementUnit        @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([ingredientId])
  @@index([unitId])
}

model RecipeIngredientGroup {
  id             String   @id @default(cuid())
  recipeId       String   @map("recipe_id")
  order          Int
  label          String?
  outputQuantity Decimal  @map("output_quantity") @db.Decimal(10, 2)
  outputUnitId   String   @map("output_unit_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  recipe      Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  outputUnit  MeasurementUnit   @relation(fields: [outputUnitId], references: [id], onDelete: Restrict)
  ingredients RecipeIngredient[]

  @@index([recipeId])
  @@index([outputUnitId])
}

model RecipeEquipment {
  id        String   @id @default(cuid())
  recipeId  String   @map("recipe_id")
  order     Int
  label     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model RecipeStep {
  id        String   @id @default(cuid())
  recipeId  String   @map("recipe_id")
  order     Int
  text      String
  image     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model RecipeComment {
  id        String   @id @default(cuid())
  recipeId  String   @map("recipe_id")
  order     Int
  initials  String
  name      String
  text      String
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
  recipeSyncs CartRecipeSync[]

  @@index([userId])
}

model CartItem {
  id                 String   @id @default(cuid())
  cartId             String   @map("cart_id")
  sourceRecipeId     String?  @map("source_recipe_id")
  recipeIngredientId String?  @map("recipe_ingredient_id")
  name               String
  sticker            String
  quantity           Decimal  @db.Decimal(10, 2)
  unitId             String   @map("unit_id")
  isSubRecipe        Boolean  @default(false) @map("is_sub_recipe")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  cart Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  unit MeasurementUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([cartId, sourceRecipeId, recipeIngredientId])
  @@index([cartId])
  @@index([unitId])
}

model CartRecipeSync {
  id                   String   @id @default(cuid())
  cartId               String   @map("cart_id")
  recipeId             String   @map("recipe_id")
  syncedOutputQuantity Decimal  @map("synced_output_quantity") @db.Decimal(10, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  cart      Cart                 @relation(fields: [cartId], references: [id], onDelete: Cascade)
  lineSyncs CartRecipeLineSync[]

  @@unique([cartId, recipeId])
  @@index([cartId])
}

model CartRecipeLineSync {
  id                 String   @id @default(cuid())
  syncId             String   @map("sync_id")
  recipeIngredientId String   @map("recipe_ingredient_id")
  syncedQuantity     Decimal  @map("synced_quantity") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  sync CartRecipeSync @relation(fields: [syncId], references: [id], onDelete: Cascade)

  @@unique([syncId, recipeIngredientId])
  @@index([syncId])
}
