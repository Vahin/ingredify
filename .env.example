# Скопируйте в `.env` и при необходимости поправьте.
# Для контейнера из docker-compose.yml (дефолтные user/db/password — ingredify):
DATABASE_URL="postgresql://ingredify:ingredify@localhost:5432/ingredify?schema=public"

# Redis для сессий (docker-compose сервис redis)
REDIS_URL="redis://localhost:6379"
SESSION_COOKIE_NAME="ingredify_session"
SESSION_TTL_SECONDS="2592000"

# Пароль демо-пользователя в seed (опционально)
SEED_DEMO_PASSWORD="password123"
